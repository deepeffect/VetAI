# Google AI Studio'dan alacagin API anahtari: https://aistudio.google.com/apikey
# Gercek anahtari yalnizca backend/.env dosyasina yaz; bu dosya git'e girmez.
GEMINI_API_KEY=buraya_kendi_anahtarini_yapistir

# Kullanilacak Gemini modeli (bos birakilirsa gemini_api.py'deki varsayilan kullanilir).
# Gemini 2.5 serisi yeni projelere kapali; guncel kararli surumler: gemini-3.8-flash,
# gemini-3.5-flash-lite (daha ucuz).
GEMINI_MODEL=gemini-3.8-flash

# Tek bir Gemini cagrisi icin zaman asimi (milisaniye)
GEMINI_TIMEOUT_MS=30000

# /api/chat: Gemini'ye gonderilen azami gecmis mesaj sayisi (token maliyeti siniri)
CHAT_HISTORY_LIMIT=12

# SQLite veritabani dosyasi
DATABASE_URL=sqlite:///./vetai.db

# CORS icin izin verilen frontend adresleri (virgulle ayrilir)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# Gemini kapaliyken (anahtar yoksa) sistem yine de ML sonucu dondurur
